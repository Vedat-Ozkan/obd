{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    // TypeScript 6 no longer auto-includes @types/*; test files under packages/*/test read fixtures with node:fs.
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts"]
}
